# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS deps

WORKDIR /build

COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM deps AS frontend-builder

COPY tsconfig.json vite.config.ts ./
COPY app/assets ./app/assets
COPY app/templates ./app/templates
RUN npm run build

FROM deps AS server-builder

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npm run build:server

FROM node:24-bookworm-slim AS prod-deps

WORKDIR /build

COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

FROM node:24-bookworm-slim AS runtime

WORKDIR /service_root

ENV NODE_ENV=production

RUN apt-get update && apt-get install --no-install-recommends -y curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY --from=prod-deps /build/node_modules ./node_modules
COPY --from=server-builder /build/dist ./dist
COPY app/static ./app/static
COPY --from=frontend-builder /build/app/static/ ./app/static/

USER node

EXPOSE 8001

HEALTHCHECK --interval=10m --timeout=30s --start-period=60s --retries=3 \
    CMD ["node", "--input-type=module", "-e", "import { parsePythonInt } from './dist/config/python-number.js'; import { execFileSync } from 'node:child_process'; const port = parsePythonInt(process.env.PORT ?? '8001'); if (port === undefined) process.exit(1); execFileSync('curl', ['-f', 'http://localhost:' + port + '/health'], { stdio: 'inherit' });"]

CMD ["node", "dist/main.js"]
